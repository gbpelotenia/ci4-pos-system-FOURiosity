{
    "name": "student/ci4-pos-system",
    "description": "CodeIgniter 4 Point of Sale System for a student group project",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "codeigniter4/framework": "4.7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "serve": "php spark serve",
        "migrate": "php spark migrate",
        "seed": "php spark db:seed UserSeeder"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
